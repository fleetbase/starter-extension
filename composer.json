{
    "name": "fleetbase/extension-starter",
    "version": "0.0.1",
    "description": "Starter Extension for Fleetbase",
    "keywords": [
        "fleetbase",
        "fleetbase-extension"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [],
    "require": {
        "php": "^8.2",
        "fleetbase/core-api": "^2.0",
        "php-http/guzzle7-adapter": "^1.0",
        "psr/http-factory-implementation": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.34.1",
        "laravel/framework": "^12.0",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0",
        "symfony/var-dumper": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Fleetbase\\Starter\\": "server/src/",
            "Fleetbase\\Starter\\Seeds\\": "server/seeds/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fleetbase\\Starter\\Tests\\": "server/tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Fleetbase\\Starter\\Providers\\StarterServiceProvider"
            ]
        },
        "fleetbase": {
            "sandbox-migrations": false
        }
    },
    "config": {
        "vendor-dir": "./server_vendor",
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "scripts": {
        "lint": "php-cs-fixer fix -v",
        "test:lint": "php-cs-fixer fix -v --dry-run",
        "test:types": "phpstan analyse --ansi --memory-limit=0",
        "test:unit": "pest --colors=always",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    }
}
